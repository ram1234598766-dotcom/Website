# VantaOS — Environment Configuration
# Copy this to .env.local for local development.
# For Cloudflare Pages, set these as Build environment variables in the dashboard.

# --- REQUIRED: Supabase (Auth, Forum, CloudOS sync) ---
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- REQUIRED: App URL (used for OAuth callbacks) ---
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# --- OPTIONAL: Gemini API Key (Omni-AI fallback) ---
# If not set, Omni-AI will show a connection error in the UI
GEMINI_API_KEY=""

# --- OPTIONAL: Supabase service role (privileged ops) ---
SUPABASE_SERVICE_ROLE_KEY=""
