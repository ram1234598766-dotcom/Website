# VantaOS — Environment Configuration
# =====================================
# Copy this to .env.local for local development.
#
# Build-time variables: Next.js replaces NEXT_PUBLIC_* at build time, so set
# them in your build environment (e.g. Cloudflare Workers → Settings → Variables
# and Secrets, or a .env.local file for local builds). They are inlined into the
# browser bundle — treat the browser bundle as public.

# --- OPTIONAL: Firebase (sign-in, Realtime Database, Google Drive) ---
# Leaving this block blank is fully supported: the app boots with local demo
# accounts and no cloud data. Fill in all four unmarked values to switch on real
# accounts, the shared forum/admin data tier, and Google Drive.
# Get them from Firebase console → Project settings → General → Your apps.
#
# IMPORTANT (popup sign-in):
#   1. Firebase console → Authentication → Settings → Authorized domains must
#      include the domain you deploy to (localhost works in development).
#   2. Enable the "Email/Password", "Google", and "GitHub" sign-in providers
#      under Authentication → Sign-in method.
#   3. To use Google Drive, your Google Cloud project needs the
#      "Google Drive API" enabled (APIs & Services → Library → Google Drive API).
#
# isFirebaseConfigured() needs all four: API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID.
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional extras. Neither is required for sign-in or the data tier.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# --- Firebase Realtime Database (Forum + Admin data tier) ---
# The Realtime Database shares the Firebase project config above, so this is
# normally blank: when unset, the SDK uses the project's default instance
# (https://<project-id>-default-rtdb.firebaseio.com). Set it only if your
# database lives somewhere else. Security rules live in database.rules.json and
# deploy with:  firebase deploy --only database
# There is no Firestore in this project.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""

# --- OPTIONAL: App URL (used wherever the canonical origin is needed) ---
# For local dev: http://localhost:3000
# For production: your deployed URL (Cloudflare Pages / Workers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL: Gemini API Key (Omni-AI) ---
# Set this in Cloudflare Worker secrets:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""