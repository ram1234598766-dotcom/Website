# VantaOS — Environment Configuration
# =====================================
# Copy this to .env.local for local development.
#
# Build-time variables: Next.js replaces NEXT_PUBLIC_* at build time, so set
# them in your build environment (e.g. Cloudflare Workers → Settings → Variables
# and Secrets, or a .env.local file for local builds). They are inlined into the
# browser bundle — treat the browser bundle as public.

# --- Firebase (sign-in, Realtime Database, Google Drive) ---
# No setup needed. The hosted VantaOS app is already provisioned with Firebase;
# a local clone with no NEXT_PUBLIC_FIREBASE_* values boots in demo mode with
# local accounts and no cloud data. Nothing here is required to run the app.
#
# Self-hosting your own Firebase instead? Uncomment the four core values below
# (isFirebaseConfigured() requires all four: API_KEY, AUTH_DOMAIN, PROJECT_ID,
# APP_ID) and, if your database is not the project default, the Realtime
# Database URL. There is no Firestore in this project — security rules live in
# database.rules.json and deploy with:  firebase deploy --only database
#
# NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
# NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=""

# --- OPTIONAL: App URL (used wherever the canonical origin is needed) ---
# For local dev: http://localhost:3000
# For production: your deployed URL (Cloudflare Pages / Workers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL: Gemini API Key (Omni-AI) ---
# Set this in Cloudflare Worker secrets:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# --- OPTIONAL: External SMTP relay (Email panel) ---
# The Email panel persists every message to Realtime Database first; the relay
# below adds best-effort external delivery via POST /api/email/send. Without it,
# mail is still saved to the recipient's mailbox in-app and email/send returns
# skipped:true. SMTP_USER/SMTP_PASS are secrets — set them as Worker secrets:
#   npx wrangler secret put SMTP_USER
#   npx wrangler secret put SMTP_PASS
# SMTP_HOST is the only value required to enable the relay.
SMTP_HOST=""
SMTP_PORT="587"          # 465 with SMTP_SECURE=1 (implicit TLS), else 587 (STARTTLS)
SMTP_USER=""             # optional AUTH LOGIN username
SMTP_PASS=""             # optional AUTH LOGIN password (as a Cloudflare secret)
SMTP_FROM=""             # defaults to the verified Firebase account email
SMTP_SECURE="0"          # "1" for implicit TLS over port 465