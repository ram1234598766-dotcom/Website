# VantaOS — Environment Configuration
# =====================================
# Copy this to .env.local for local development.
#
# Build-time variables: Next.js replaces NEXT_PUBLIC_* at build time, so set
# them in your build environment (e.g. Cloudflare Pages → Settings → Environment
# Variables, or a .env.local file for local builds). They are inlined into the
# static export — treat the browser bundle as public.

# --- REQUIRED: Firebase (account sign-in / sign-out) ---
# Get these from Firebase console → Project settings → General → Your apps.
# The site ships without them too: it falls back to a local demo auth, but then
# Google/GitHub OAuth and Drive are unavailable.
#
# IMPORTANT (popup sign-in):
#   1. Firebase console → Authentication → Settings → Authorized domains must
#      include the domain you deploy to (localhost works in development).
#   2. Enable the "Email/Password", "Google", and "GitHub" sign-in providers
#      under Authentication → Sign-in method.
#   3. To use Google Drive, your Google Cloud project needs the
#      "Google Drive API" enabled (APIs & Services → Library → Google Drive API).
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# --- OPTIONAL: Supabase (Forum + Admin data layer) ---
# Auth now goes through Firebase above. Supabase, if you still use it, keeps
# backing the Forum and Admin metrics. Get these from your Supabase project
# dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- OPTIONAL: App URL (used wherever the canonical origin is needed) ---
# For local dev: http://localhost:3000
# For production: your deployed URL (Cloudflare Pages / Workers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL: Gemini API Key (Omni-AI) ---
# Set this in Cloudflare Worker secrets:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# --- OPTIONAL: Supabase service role (privileged ops) ---
# WARNING: Never expose this on the client
SUPABASE_SERVICE_ROLE_KEY=""