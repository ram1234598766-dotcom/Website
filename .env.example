# Server-side secrets (available to Cloudflare Functions at runtime)
# Set these in the Cloudflare Pages dashboard under Settings > Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Public client configuration (NEXT_PUBLIC_* vars are inlined at BUILD time)
# Set these in Cloudflare Pages > Build environment variables, or in a local .env.local
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional server-only Supabase key (used by privileged server operations)
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment (used for OAuth callbacks / self-references)
NEXT_PUBLIC_APP_URL="MY_APP_URL"
