# VantaOS — Environment Configuration
# =====================================
# Copy this to .env.local for local development.
# For Cloudflare Workers deployment, set these as secrets/secrets in the dashboard.
#
# Build-time variables (Next.js replaces NEXT_PUBLIC_* at build time):
#   Cloudflare Pages: set in Dashboard → your project → Settings → Environment Variables
#   wrangler deploy:  set via `npx wrangler secret put <NAME>` for Worker env vars

# --- REQUIRED: Supabase (Auth, Forum, CloudOS sync) ---
# Get these from your Supabase project dashboard (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- REQUIRED: App URL (used for OAuth callbacks) ---
# For local dev: http://localhost:8080
# For production: your Cloudflare Workers URL
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# --- OPTIONAL: Gemini API Key (Omni-AI) ---
# Set this in Cloudflare Worker secrets:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# --- OPTIONAL: Supabase service role (privileged ops) ---
# WARNING: Never expose this on the client
SUPABASE_SERVICE_ROLE_KEY=""
