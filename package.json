{
  "name": "vantaos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npx opennextjs-cloudflare build --skipNextBuild",
    "postbuild": "node scripts/fix-cache.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-vantaos \"vitest run --config vitest.rules.config.ts\"",
    "start": "next start",
    "deploy": "npx wrangler deploy",
    "cf-preview": "npx wrangler dev",
    "firebase:deploy": "firebase deploy --only database",
    "setup": "bash scripts/setup.sh",
    "quickstart": "make quickstart"
  },
