generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LionModules {
  id        String   @id @default(uuid())
  name      String
  version   String
  code      String
  createdAt DateTime @default(now())
}

model UserTrainingJobs {
  id        String   @id @default(uuid())
  userId    String
  modelName String
  status    String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
}

model SystemLogs {
  id        String   @id @default(uuid())
  action    String
  type      String
  timestamp DateTime @default(now())
}
