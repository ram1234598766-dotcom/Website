{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "allowJs": true,
    "incremental": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      { "name": "next" }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.js", "**/*.cjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
